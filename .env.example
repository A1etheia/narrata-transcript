# Vorlage für Secrets. Kopieren nach .env und dort ausfüllen; .env ist gitignored.
# Eine Variable aus der Umgebung hat Vorrang vor .env.

# Narrata-Token der aktiven Spielleitung für den Abruf des Transkriptionskontexts.
# Vorerst der normale Login-Token (24 h gültig), also vor dem Abruf frisch eintragen;
# ein langlebiger Pipeline-Token kommt mit IOA-1251.
NARRATA_TOKEN=
