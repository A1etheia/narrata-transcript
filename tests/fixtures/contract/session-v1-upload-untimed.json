            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_00",
            "participant_id": 101,
            "text": "„Mein Sohn. Vor drei Jahren, in der Nacht nach dem Brückenfest.“",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
