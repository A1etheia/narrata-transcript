            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_00",
            "participant_id": 101,
            "text": "Eine ältere Frau öffnet. Sie stellt sich als Ysolde vor.",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
        {
            "id": "u-000048-speaker-01",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_01",
            "participant_id": 102,
            "text": "Wir suchen ein Dach für die Nacht und eine Überfahrt morgen früh.",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
        {
            "id": "u-000049-speaker-00",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_00",
            "participant_id": 101,
            "text": "Ysolde mustert euch. „Morgen ist Brückenfest, da setzt niemand über.“",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
        {
            "id": "u-000050-speaker-03",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_03",
            "participant_id": 104,
            "text": "Was genau passiert beim Brückenfest?",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
        {
            "id": "u-000051-speaker-00",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_00",
            "participant_id": 101,
            "text": "Die ganze Stadt schmückt die alte Brücke, und abends wird das Lied der Nebelfrau gesungen.",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
