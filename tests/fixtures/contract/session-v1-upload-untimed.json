            "id": "u-000052-speaker-04",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_04",
            "participant_id": null,
            "text": "Soll ich schon mal Tee aufsetzen?",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
        {
            "id": "u-000053-speaker-02",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_02",
            "participant_id": 103,
            "text": "Gern, danke. Zurück ins Spiel: ich frage nach der Nebelfrau.",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
        },
        {
            "id": "u-000054-speaker-00",
            "start": null,
            "end": null,
            "speaker_label": "SPEAKER_00",
            "participant_id": 101,
            "text": "Ysolde wird leiser. „Man sagt, sie holt sich jedes Jahr einen, der zu spät über die Brücke geht.“",
            "asr_text": null,
            "confidence_tier": null,
            "review_status": "unreviewed",
            "review_note": null,
            "markers": [],
            "segment_ref": null,
            "knowledge_hints": [],
            "layers": {}
