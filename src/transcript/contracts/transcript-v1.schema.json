{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrata.cloud/contracts/transcript-v1.schema.json",
  "title": "Narrata session transcript, contract v1",
  "description": "One structured transcript of one play session, written by the Transcript pipeline (TOOL-69) or, since 1.3, converted from an upload (source.kind = upload), and read by Narrata (IOA-1218). Human-readable contract: docs/transcript-contract.md. Rules a schema cannot express (unique ids, chronological order, end >= start, known speaker labels, supported major, the IT/OT cross-references, which values only an upload may leave null) are checked by transcript:validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool_version",
    "session",
    "source",
    "pipeline",
    "speakers",
    "stats",
    "passages"
  ],
  "properties": {
    "contract_version": {
      "description": "\"<major>.<minor>\". Additive changes bump the minor, breaking changes the major; a reader refuses an unknown major.",
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)$"
    },
    "tool_version": {
      "description": "Version of the pipeline or converter that wrote the file.",
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "ordinal", "play_session_id", "session_date"],
      "properties": {
        "group": {
          "description": "Narrata group id.",
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "description": "Running number of the session within the group.",
          "type": "integer",
          "minimum": 1
        },
        "play_session_id": {
          "description": "Narrata play_sessions.id, as returned by transcription-context.",
          "type": "integer",
          "minimum": 1
        },
        "session_date": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "source": {
      "description": "Where the transcript comes from. Null values (duration, audio hash) only for source.kind = upload.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "duration_seconds", "audio_sha256"],
      "properties": {
        "file_name": {
          "description": "Audio file name without any path.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "duration_seconds": {
          "description": "Null only for source.kind = upload.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "audio_sha256": {
          "description": "Null only for source.kind = upload.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "description": "Since 1.3, optional: pipeline (the default when absent) or upload, a transcript converted from a foreign file.",
          "enum": ["pipeline", "upload"]
        },
        "format": {
          "description": "Since 1.3: the origin of an upload; required for source.kind = upload, absent otherwise.",
          "enum": ["vtt", "srt", "text"]
        },
        "recordings": {
          "description": "Since 1.1, optional: every recording of the session in session order; the first equals the top-level source fields.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/recording"
          }
        }
      }
    },
    "pipeline": {
      "description": "Null only for source.kind = upload.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["backend", "model", "config_hash", "knowledge_snapshot_id", "thresholds"],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_snapshot_id": {
          "description": "Id of the transcription-context snapshot used for keyword biasing, or null.",
          "type": ["string", "null"]
        },
        "thresholds": {
          "description": "Pipeline thresholds; open object, not interpreted by Narrata.",
          "type": "object"
        }
      }
    },
    "speakers": {
      "description": "Speaker label -> assigned participant, or null when the label is not assigned to anyone.",
      "type": "object",
      "propertyNames": {
        "description": "Same rule as $defs/speaker_label, without the type: JSON keys are always strings, but PHP-based readers see numeric keys as integers.",
        "minLength": 1,
        "pattern": "[A-Za-z0-9]"
      },
      "additionalProperties": {
        "$ref": "#/$defs/speaker"
      }
    },
    "stats": {
      "description": "Pipeline report figures (TOOL-53). Open object; Narrata reads only stats.it_ot (since 1.2).",
      "type": "object",
      "properties": {
        "it_ot": {
          "$ref": "#/$defs/it_ot_stats"
        }
      }
    },
    "passages": {
      "description": "Chronological by start.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/passage"
      }
    }
  },
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "duration_seconds", "audio_sha256", "starts_at"],
      "properties": {
        "file_name": {
          "description": "Audio file name without any path.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "audio_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "starts_at": {
          "description": "Absolute seconds on the session timeline at which this recording starts.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "speaker_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "[A-Za-z0-9]"
    },
    "participant_id": {
      "description": "Narrata users.id (transcription-context participants[].user_id), or null.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "speaker": {
      "description": "null = label not assigned; properties/required apply to the object form only.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["participant_id", "display_name"],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/participant_id"
        },
        "display_name": {
          "type": ["string", "null"]
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "speaker_label",
        "participant_id",
        "text",
        "asr_text",
        "confidence_tier",
        "review_status",
        "review_note",
        "markers",
        "segment_ref",
        "knowledge_hints",
        "layers"
      ],
      "properties": {
        "id": {
          "description": "Stable passage id, minted once as p-<start in ms, 8 digits>-<speaker label slug> and kept on every re-export; an untimed upload mints u-<position from 1, 6 digits>-<speaker label slug> instead.",
          "type": "string",
          "pattern": "^(p-[0-9]{8}|u-[0-9]{6})-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "start": {
          "description": "Absolute seconds from the start of the recording, at most three decimals; null in an untimed upload.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "end": {
          "description": "Absolute seconds from the start of the recording, at most three decimals; not before start; null in an untimed upload.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "speaker_label": {
          "description": "Must be a key of speakers.",
          "$ref": "#/$defs/speaker_label"
        },
        "participant_id": {
          "$ref": "#/$defs/participant_id"
        },
        "text": {
          "description": "Cleaned working text.",
          "type": "string"
        },
        "asr_text": {
          "description": "Raw ASR text when it differs from text, else null.",
          "type": ["string", "null"]
        },
        "confidence_tier": {
          "description": "Null only for source.kind = upload.",
          "enum": ["confident", "needs_review", "uncertain", null]
        },
        "review_status": {
          "enum": ["unreviewed", "confirmed", "corrected", "open"]
        },
        "review_note": {
          "type": ["string", "null"]
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "segment_ref": {
          "description": "Source segment, when the recording was split; else null.",
          "type": ["string", "null"]
        },
        "knowledge_hints": {
          "description": "World-archive entries that influenced this passage.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledge_hint"
          }
        },
        "layers": {
          "description": "Open object for layers. layers.it_ot (since 1.2) is the in-time / out-of-time classification; all passages carry it or none.",
          "type": "object",
          "properties": {
            "it_ot": {
              "$ref": "#/$defs/it_ot_layer"
            }
          }
        }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at"],
      "properties": {
        "type": {
          "enum": ["unintelligible", "speaker_unclear", "crosstalk", "gap"]
        },
        "at": {
          "description": "Absolute seconds from the start of the recording; null in an untimed upload.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "knowledge_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["place", "person", "artifact", "organisation", "event", "lore"]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "frame": {
      "description": "it = in-time (the fiction), ot = out-of-time (table talk), mixed = both in one passage, unclear = not decidable.",
      "enum": ["it", "ot", "mixed", "unclear"]
    },
    "mode": {
      "description": "Inside IT: speech = character speech, narration = description, action = a player's action call.",
      "enum": ["speech", "narration", "action"]
    },
    "reason": {
      "description": "Machine-readable reason category, an open snake_case catalogue (rule_talk, dice_call, break, meta_comment, agreement, organisational, …).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "char_offset": {
      "description": "Character offset into text (Unicode code points), from inclusive, to exclusive.",
      "type": "integer",
      "minimum": 0
    },
    "frame_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "frame"],
      "properties": {
        "from": {
          "$ref": "#/$defs/char_offset"
        },
        "to": {
          "$ref": "#/$defs/char_offset"
        },
        "frame": {
          "enum": ["it", "ot"]
        }
      }
    },
    "mode_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "mode"],
      "properties": {
        "from": {
          "$ref": "#/$defs/char_offset"
        },
        "to": {
          "$ref": "#/$defs/char_offset"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        }
      }
    },
    "it_ot_layer": {
      "description": "Since 1.2: the IT/OT classification of one passage (TOOL-71). Frame-bound fields follow frame, the model result, not review.manual_frame.",
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "mode_confidence": ["mode"],
        "mode_spans": ["mode"]
      },
      "required": ["frame", "confidence", "tier", "reason", "pass", "block"],
      "properties": {
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "confidence": {
          "$ref": "#/$defs/probability"
        },
        "tier": {
          "enum": ["confident", "needs_review", "uncertain"]
        },
        "reason": {
          "description": "Reason category or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "pass": {
          "description": "Which classification pass set this result, starting at 1.",
          "type": "integer",
          "minimum": 1
        },
        "first_pass": {
          "description": "Optional: the first pass's result, kept when a later pass changed it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["frame", "confidence"],
          "properties": {
            "frame": {
              "$ref": "#/$defs/frame"
            },
            "confidence": {
              "$ref": "#/$defs/probability"
            }
          }
        },
        "block": {
          "description": "Id of the block in stats.it_ot.blocks this passage belongs to.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "spans": {
          "description": "Optional, only for frame mixed: the IT and OT parts of text.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame_span"
          }
        },
        "mode": {
          "description": "Optional, only for frame it or mixed.",
          "$ref": "#/$defs/mode"
        },
        "mode_confidence": {
          "description": "Optional, only for frame it or mixed, only with mode.",
          "$ref": "#/$defs/probability"
        },
        "mode_spans": {
          "description": "Optional, only for frame it or mixed, only with mode: parts of text with a different mode.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mode_span"
          }
        },
        "review": {
          "description": "Optional: the manual review result; it adds to the model result instead of replacing it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["manual_frame"],
          "properties": {
            "manual_frame": {
              "anyOf": [
                {
                  "$ref": "#/$defs/frame"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds", "passages"],
      "properties": {
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "passages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "it_ot_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame", "start", "end", "first_passage_id", "last_passage_id", "trigger_label", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "frame": {
          "enum": ["it", "ot"]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "first_passage_id": {
          "type": "string",
          "minLength": 1
        },
        "last_passage_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger_label": {
          "description": "Speaker label of the passage that opened the block, or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/speaker_label"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "description": "For OT blocks the reason category, else null.",
          "anyOf": [
            {
              "$ref": "#/$defs/reason"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "it_ot_speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "talk_seconds", "it_seconds", "ot_triggers"],
      "properties": {
        "label": {
          "$ref": "#/$defs/speaker_label"
        },
        "talk_seconds": {
          "type": "number",
          "minimum": 0
        },
        "it_seconds": {
          "type": "number",
          "minimum": 0
        },
        "ot_triggers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "it_ot_stats": {
      "description": "Since 1.2: the IT/OT session statistics (TOOL-75), required exactly when the passages carry layers.it_ot. Figures only, never passage text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["shares", "blocks", "speakers"],
      "properties": {
        "shares": {
          "description": "Speaking time and passage count per frame; one key per frame.",
          "type": "object",
          "propertyNames": {
            "enum": ["it", "ot", "mixed", "unclear"]
          },
          "required": ["it", "ot", "mixed", "unclear"],
          "additionalProperties": {
            "$ref": "#/$defs/share"
          }
        },
        "blocks": {
          "description": "Contiguous IT and OT blocks in session order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/it_ot_block"
          }
        },
        "speakers": {
          "description": "Per speaker label: speaking time overall and inside IT, OT blocks opened.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/it_ot_speaker"
          }
        }
      }
    }
  }
}
